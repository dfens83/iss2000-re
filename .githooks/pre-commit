#!/bin/sh
# Blocks ROM data and oversized files outside approved reference-media paths.
# Enable once per clone:  git config core.hooksPath .githooks
set -eu

if command -v python3 >/dev/null 2>&1 && python3 -c 'import sys; sys.exit(sys.version_info[0] != 3)' 2>/dev/null; then
  exec python3 tools/precommit_guard.py
elif command -v python >/dev/null 2>&1 && python -c 'import sys; sys.exit(sys.version_info[0] != 3)' 2>/dev/null; then
  exec python tools/precommit_guard.py
else
  echo "BLOCKED: Python 3 is required to run the repository pre-commit guard."
  exit 1
fi
